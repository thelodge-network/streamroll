# StreamRoll / LODGEFLIX — environment (copy to .env; never commit .env)

# Runway path (optional server fallback; the app is BYOK — key is normally entered in-browser at /setup)
RUNWAYML_API_SECRET=your_runway_api_key_here

# Google direct path (Gemini image + Veo video). REQUIRED for the Google provider.
# *** Must be a BILLING-ENABLED Google AI Studio key *** — gemini-3-pro-image and Veo 3.1 are
# paid-tier models (free-tier quota for both is 0). Source from Vaultwarden, never commit.
GOOGLE_AI_API_KEY=your_google_ai_studio_key_here

# Where finished pre-rolls are written (container path; media share mounted at /media).
PREROLL_DIR=/media/Pre-Rolls
# The audio sting to mux (already on the NAS). Defaults to <PREROLL_DIR>/netflix.wav.
STING_PATH=/media/Pre-Rolls/netflix.wav
